#!/usr/bin/env python3
"""ai-sync - Interactive REPL driver for skill and MCP sync operations.

Sub-scripts (each has a specific task):
  scripts/sync-skills.sh      [skill_name]   - Sync skill(s) to Claude, Codex, OpenCode
  scripts/sync-mcp-collect.py - Collect MCP definitions from all agent configs
  scripts/sync-mcp-distribute.py [server_name] - Distribute MCP server(s) to all agents
"""

import json
import os
import subprocess
import sys

REPO_DIR = "/home/perez/projetos/ai-tools"
SKILLS_DIR = os.path.join(REPO_DIR, "skills")
MCP_FILE = os.path.join(REPO_DIR, "mcp", "servers.json")


def list_skills():
    skills = []
    if os.path.isdir(SKILLS_DIR):
        for name in sorted(os.listdir(SKILLS_DIR)):
            path = os.path.join(SKILLS_DIR, name)
            if os.path.isdir(path) and name != "AGENT.md" and not name.startswith("."):
                skills.append((name, path))
    return skills


def list_mcp_servers():
    if not os.path.exists(MCP_FILE):
        return []
    with open(MCP_FILE, "r") as f:
        data = json.load(f)
    return [(name, config) for name, config in data.items() if name != "sources"]


def skill_status(name):
    """Return (claude, codex, opencode) booleans - True if skill dir exists."""
    paths = [
        os.path.expanduser(f"~/.claude/skills/{name}"),
        os.path.expanduser(f"~/.codex/skills/{name}"),
        os.path.expanduser(f"~/.config/opencode/skills/{name}"),
    ]
    return tuple(os.path.isdir(p) for p in paths)


def mcp_status(name):
    """Return (opencode, claude, codex) booleans - True if MCP server present."""
    import json5

    opencode = claude = codex = False

    opencode_path = os.path.expanduser("~/.config/opencode/opencode.jsonc")
    if os.path.exists(opencode_path):
        with open(opencode_path, "r") as f:
            data = json5.load(f)
        if name in data.get("mcp", {}):
            opencode = True

    claude_path = os.path.expanduser("~/.claude.json")
    if os.path.exists(claude_path):
        with open(claude_path, "r") as f:
            data = json.load(f)
        if name in data.get("mcpServers", {}):
            claude = True

    codex_path = os.path.expanduser("~/.codex/config.toml")
    if os.path.exists(codex_path):
        with open(codex_path, "r") as f:
            content = f.read()
        if f"[mcp_servers.{name}]" in content:
            codex = True

    return opencode, claude, codex


def ask_interactive_or_not():
    """First question: interactive or non-interactive mode."""
    print("Interactive mode? (interactive / non-interactive)")
    try:
        line = sys.stdin.readline()
    except EOFError:
        return False
    if not line:
        return False
    answer = line.strip().lower()
    return answer != "non-interactive"


def run_full_sync():
    print("Non-interactive mode: running full sync...")
    subprocess.run(
        ["bash", os.path.join(REPO_DIR, "scripts", "sync-skills.sh")], check=True
    )
    subprocess.run(
        [sys.executable, os.path.join(REPO_DIR, "scripts", "sync-mcp-collect.py")],
        check=True,
    )
    subprocess.run(
        [sys.executable, os.path.join(REPO_DIR, "scripts", "sync-mcp-distribute.py")],
        check=True,
    )
    print("Full sync complete!")


def run_interactive():
    while True:
        total_skills = len(list_skills())
        total_mcp = len(list_mcp_servers())
        total = total_skills + total_mcp

        print("\n" + "=" * 60)
        print("AI-SYNC INTERACTIVE")
        print("=" * 60)

        print("\nSKILLS (choose a number to sync to all agents):")
        print(f"{'#':<6} {'Name':<20} {'Claude':<10} {'Codex':<10} {'OpenCode':<10}")
        print("-" * 60)
        skills = list_skills()
        for i, (name, _) in enumerate(skills, 1):
            cl, cx, oc = skill_status(name)
            cl_status = "✓" if cl else "✗"
            cx_status = "✓" if cx else "✗"
            oc_status = "✓" if oc else "✗"
            print(f"{i:<6} {name:<20} {cl_status:<10} {cx_status:<10} {oc_status:<10}")

        print("\nMCP SERVERS (choose a number to distribute to all agents):")
        print(f"{'#':<6} {'Name':<20} {'Claude':<10} {'Codex':<10} {'OpenCode':<10}")
        print("-" * 60)
        mcp_servers = list_mcp_servers()
        for i, (name, config) in enumerate(mcp_servers, total_skills + 1):
            oc, cl, cx = mcp_status(name)
            cl_status = "✓" if cl else "✗"
            cx_status = "✓" if cx else "✗"
            oc_status = "✓" if oc else "✗"
            print(f"{i:<6} {name:<20} {cl_status:<10} {cx_status:<10} {oc_status:<10}")

        print("\nCommands:")
        print("  [a] Collect MCP definitions from all agents")
        print("  [d] Distribute MCP definitions to all agents")
        print("  [q] Quit")

        try:
            line = sys.stdin.readline()
        except EOFError:
            break
        if not line:
            break
        choice = line.strip().lower()

        if choice in ("q", "0"):
            print("Exiting ai-sync.")
            break
        elif choice == "a":
            print("\n[a] Collecting MCP definitions from all agents...")
            subprocess.run(
                [sys.executable, os.path.join(REPO_DIR, "scripts", "sync-mcp-collect.py")],
                check=True,
            )
        elif choice == "d":
            print("\n[d] Distributing MCP definitions to all agents...")
            subprocess.run(
                [
                    sys.executable,
                    os.path.join(REPO_DIR, "scripts", "sync-mcp-distribute.py"),
                ],
                check=True,
            )
        else:
            try:
                idx = int(choice)
                skills = list_skills()
                mcp_servers = list_mcp_servers()
                if idx <= len(skills):
                    name = skills[idx - 1][0]
                    print(f"\nSyncing skill '{name}'...")
                    subprocess.run(
                        ["bash", os.path.join(REPO_DIR, "scripts", "sync-skills.sh"), name],
                        check=True,
                    )
                elif idx <= len(skills) + len(mcp_servers):
                    mcp_name = mcp_servers[idx - len(skills) - 1][0]
                    print(f"\nDistributing MCP server '{mcp_name}'...")
                    subprocess.run(
                        [
                            sys.executable,
                            os.path.join(REPO_DIR, "scripts", "sync-mcp-distribute.py"),
                        ],
                        check=True,
                    )
                else:
                    print("Invalid choice.")
            except ValueError:
                print("Invalid choice.")


def main():
    if "--non-interactive" in sys.argv:
        run_full_sync()
        return
    if ask_interactive_or_not():
        run_interactive()
    else:
        run_full_sync()


if __name__ == "__main__":
    main()
