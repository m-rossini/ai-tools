#!/bin/bash

# ai-sync - Sync individual skill directories from repo to user-level ~/.claude/skills and ~/.codex/skills
# Ensures symlinks exist without deleting existing skills not in repo.

REPO_SKILLS_DIR="/home/perez/projetos/ai-tools/skills"
if [ ! -d "$REPO_SKILLS_DIR" ]; then
  echo "Error: Repository skills directory not found at $REPO_SKILLS_DIR"
  exit 1
fi

# Function to safely create or update a symlink
safe_symlink() {
  local src=$1
  local dst=$2
  if [ -L "$dst" ]; then
    # It's a symlink, check if points to correct source
    local current=$(readlink "$dst" 2>/dev/null || echo "")
    if [ "$current" = "$src" ]; then
      # already correct
      return 0
    else
      # points elsewhere, replace
      rm -f "$dst"
      ln -sf "$src" "$dst"
    fi
  elif [ -e "$dst" ]; then
    # exists but not a symlink; skip to avoid overwriting
    echo "Warning: $dst exists and is not a symlink; skipping"
    return 1
  else
    # doesn't exist, create symlink
    ln -sf "$src" "$dst"
  fi
}

# Ensure user directories exist
mkdir -p ~/.claude/skills
mkdir -p ~/.codex/skills

# AGENT.md symlink for Claude
AGENT_REPO="$REPO_SKILLS_DIR/AGENT.md"
AGENT_CLAUDE=~/.claude/AGENT.md
if [ ! -L "$AGENT_CLAUDE" ]; then
  ln -sf "$AGENT_REPO" "$AGENT_CLAUDE"
elif [ -L "$AGENT_CLAUDE" ]; then
  if [ "$(readlink "$AGENT_CLAUDE")" != "$AGENT_REPO" ]; then
    rm -f "$AGENT_CLAUDE"
    ln -sf "$AGENT_REPO" "$AGENT_CLAUDE"
  fi
fi

# AGENT.md symlink for Codex
AGENT_CLAUDEX=~/.codex/AGENT.md
if [ ! -L "$AGENT_CLAUDEX" ]; then
  ln -sf "$AGENT_REPO" "$AGENT_CLAUDEX"
elif [ -L "$AGENT_CLAUDEX" ]; then
  if [ "$(readlink "$AGENT_CLAUDEX")" != "$AGENT_REPO" ]; then
    rm -f "$AGENT_CLAUDEX"
    ln -sf "$AGENT_REPO" "$AGENT_CLAUDEX"
  fi
fi

# Loop over each skill directory in repo
for skill_dir in "$REPO_SKILLS_DIR"/*; do
  # Skip if not a directory
  [ -d "$skill_dir" ] || continue
  skill_name=$(basename "$skill_dir")
  # Skip if it's AGENT.md (already handled)
  [ "$skill_name" = "AGENT.md" ] && continue

  # Create symlinks for both user directories
  safe_symlink "$skill_dir" ~/.claude/skills/"$skill_name"
  safe_symlink "$skill_dir" ~/.codex/skills/"$skill_name"
done

echo "Sync complete."